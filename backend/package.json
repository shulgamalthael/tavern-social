{
  "name": "tavern-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Tavern backend — NestJS API + Socket.IO real-time layer",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "npm run build && concurrently -k -n build,alias,run -c blue,magenta,green \"npm:dev:build\" \"npm:dev:alias\" \"npm:dev:run\"",
    "dev:build": "tsc -w -p tsconfig.build.json --preserveWatchOutput",
    "dev:alias": "tsc-alias -w -p tsconfig.build.json",
    "dev:run": "nodemon",
    "start:debug": "nodemon --exec \"node --enable-source-maps --inspect=0.0.0.0:9229 dist/main.js\"",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.config.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.config.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"*.config.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "fix": "npm run lint:fix && npm run format && npm run check",
    "prisma:generate": "prisma generate",
    "migration:dev": "prisma migrate dev",
    "migration:deploy": "prisma migrate deploy",
    "migration:create": "prisma migrate dev --create-only",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.16.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.6",
    "prisma": "^6.16.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.44.0": true,
    "prisma@6.19.3": true
  }
}
