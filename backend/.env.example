# Скопируйте в .env и подставьте свои значения: `cp .env.example .env`.
# Не коммитьте .env — только .env.example с задокументированными плейсхолдерами.

NODE_ENV=development
PORT=4000

# Внутри docker-compose имя хоста — это имя сервиса (postgres/redis), не localhost.
DATABASE_URL=postgresql://tavern:tavern@postgres:5432/tavern?schema=public
REDIS_URL=redis://redis:6379

# Origin frontend — используется для CORS (REST + Socket.IO handshake).
FRONTEND_URL=http://localhost:3000

# Время жизни сессии в секундах (по умолчанию 30 дней) — совпадает с
# maxAge httpOnly cookie на frontend (см. frontend/.env.example).
SESSION_TTL_SECONDS=2592000

# Время жизни одноразового билета для подключения к Socket.IO.
SOCKET_TICKET_TTL_SECONDS=60

# debug|log|warn|error — необязательно, по умолчанию Nest сам решает по NODE_ENV.
LOG_LEVEL=
